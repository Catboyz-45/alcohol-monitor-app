rules_version = '2';

// Security Rules สำหรับ Alcohol Monitor
// - ต้องเข้าสู่ระบบ และมีเอกสาร officers/{uid} (ผู้ดูแลเพิ่มเองใน Firebase Console)
// - การสมัครบัญชีเองผ่าน API key จึงไม่ได้สิทธิ์อ่านข้อมูลผู้รับการตรวจ
// deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOfficer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/officers/$(request.auth.uid));
    }

    function validMeasurement() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'name', 'idCard', 'age', 'licensePlate', 'province',
          'alcoholValue', 'status', 'timestamp', 'createdBy'
        ])
        && d.keys().hasAll([
          'id', 'name', 'idCard', 'age', 'licensePlate', 'province',
          'alcoholValue', 'status', 'timestamp', 'createdBy'
        ])
        && d.id is string && d.id == request.resource.id
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.idCard is string && d.idCard.matches('^[0-9]{13}$')
        && d.age is int && d.age >= 1 && d.age <= 120
        && d.licensePlate is string && d.licensePlate.size() > 0
        && d.licensePlate.size() <= 20
        && d.province is string && d.province.size() <= 40
        && d.alcoholValue is number && d.alcoholValue >= 0
        && d.alcoholValue <= 100
        && d.status in ['SAFE', 'WARNING', 'DRUNK']
        && d.timestamp is timestamp
        && d.createdBy == request.auth.uid;
    }

    // รายชื่อเจ้าหน้าที่: อ่านได้เฉพาะของตัวเอง แก้ไขได้จาก Console เท่านั้น
    match /officers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /measurements/{recordId} {
      allow read, delete: if isOfficer();
      allow create, update: if isOfficer() && validMeasurement();
    }

    // ปิดทุก collection อื่น
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
